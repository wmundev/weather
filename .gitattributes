# Normalise line endings: LF in the repository, native in the working tree.
# This matches how the history is already stored, so adding this file does not
# rewrite anything - it just stops Git warning on every touched file.
* text=auto

#
# Files that must be LF in the working tree too
#
# These run under bash on Linux CI runners and through Git Bash locally; CRLF
# breaks the shebang line and trailing \r on commands such as `exit 0`.
*.sh            text eol=lf
.githooks/*     text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

#
# Files that are CRLF by tooling convention
#
*.sln           text eol=crlf
*.props         text eol=crlf
*.targets       text eol=crlf

#
# Language hints - better diff hunk headers
#
*.cs            text diff=csharp
*.csproj        text
*.bru           text
*.tf            text
*.tfvars        text

#
# Generated - keep out of diffs and language stats
#
api.yaml                            linguist-generated=true
weather-backend/Assets/Generated/** linguist-generated=true -diff
weather-backend.Deployment/cdk.out/** linguist-generated=true -diff

#
# Binary
#
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.snk    binary
*.db     binary
