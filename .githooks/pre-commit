#!/bin/sh
#
# Regenerates api.yaml and stages it, so the committed spec always matches the code.
# Enable once per clone with: git config core.hooksPath .githooks
#
# Note: the spec is generated from the working tree, not the index - see the commit-changes skill.
set -e

repoTopLevel=$(git rev-parse --show-toplevel)

if ! "$repoTopLevel/scripts/generate-openapi-docs.sh"; then
  echo "pre-commit: api.yaml generation failed - fix the build and commit again." >&2
  exit 1
fi

git add "$repoTopLevel/api.yaml"
