<Project>
  <!--
    Shared by every project in the solution. weather-backend.Deployment is generated by
    aws-dotnet-deploy, is not in weather.sln, and keeps its own settings.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'weather-backend.Deployment'">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The build is warning-free; keep it that way. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A newly published vulnerability advisory should show up as a warning, not break every build
         and deploy until a fix is released. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
