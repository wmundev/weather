<Project>
  <!--
    Central package management: every NuGet version used by the solution lives here, and project files
    reference packages without a Version. One place to bump, one Dependabot group, no drift between
    projects. weather-backend.Deployment is generated by aws-dotnet-deploy and manages its own versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="'$(MSBuildProjectName)' != 'weather-backend.Deployment'">true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="AWS">
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="3.7.513.4" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.400.2" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="3.7.504.50" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="3.7.505.15" />
    <PackageVersion Include="AWSSDK.Translate" Version="3.7.501.59" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="ConfigCat.Client" Version="9.5.1" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.40" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Sodium.Core" Version="1.4.1" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <!-- Keep the swashbuckle.aspnetcore.cli tool in .config/dotnet-tools.json on the same version. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
