meta {
  name: Get Academic By Id
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/academic?id=100
  body: none
  auth: inherit
}

params:query {
  id: 100
}

docs {
  `GET /academic`

  | Param | Required | Notes                    |
  | ----- | -------- | ------------------------ |
  | `id`  | yes      | Academic `ACNUM`         |

  Returns the `Academic` record, `404` when no record has that ID, or `503` when
  `ConnectionStrings:Academic` is not configured. The seed data starts at
  `ACNUM` 100. No status assertion, since the result depends on Postgres being
  configured and seeded.
}
