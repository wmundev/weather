meta {
  name: Get Email Code - Missing Key (401)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/email/code
  body: none
  auth: inherit
}

docs {
  `GET /api/email/code` without the `X-Api-Key` header.

  Answers `401` when the API has a key configured, and `503` when it has none -
  so there is no status assert. Either way the record is never read.
}
