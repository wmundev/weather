meta {
  name: Get Location
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/geolocation/location
  body: none
  auth: inherit
}

docs {
  `GET /geolocation/location`

  Returns the caller's approximate geographic location.

  Returns `400` with `ProblemDetails` ("Unknown client IP address") when the
  remote IP cannot be determined - which is the usual outcome when calling over
  loopback, so no status assertion is set on this request.
}
