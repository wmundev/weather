<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>weather_backend</RootNamespace>
    <UserSecretsId>66887dce-0c73-4d4a-a042-434b84113960</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" />
    <PackageReference Include="AWSSDK.Translate" />
    <PackageReference Include="ConfigCat.Client" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="libphonenumber-csharp" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Sodium.Core" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
    <!-- Newtonsoft.Json is used by LanguageTranslatorService (ExpandoObjectConverter) only;
         the weather models are serialized with System.Text.Json. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The city dataset must reach the output directory: a <Folder> entry is only an IDE marker and
         copies nothing, which left CityRepository reading a path that does not exist once published. -->
    <Content Update="Assets\city.list.json" CopyToOutputDirectory="PreserveNewest" />
    <Folder Include="HealthChecks\" />
    <Folder Include="Services\Scheduler\Jobs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\weather-application\weather-application.csproj" />
    <ProjectReference Include="..\weather-repository\weather-repository.csproj" />
  </ItemGroup>
</Project>